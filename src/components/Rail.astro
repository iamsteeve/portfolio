---
import type { Copy } from '../content/types';
import { LANGUAGES, LINKS, PALETTES, type Lang } from '../data/site';

interface Props {
  lang: Lang;
  t: Copy;
}

const { lang, t } = Astro.props;
---

<aside class="rail">
  <a class="rail__name" href="#top">Steeve Luis Angel<br />Torres Agustin</a>
  <p class="rail__role">{t.railRole}</p>

  <nav class="rail__nav" aria-label={t.navAria}>
    <ul class="rail__nav-list">
      {
        t.nav.map((item) => (
          <li>
            <a class="rail__nav-link" data-nav href={item.href}>
              <span class="rail__tick" data-tick aria-hidden="true" />
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <ul class="rail__links">
    <li>
      <a class="rail__link" href={LINKS.github} target="_blank" rel="noopener noreferrer">{LINKS.githubLabel}</a>
    </li>
    <li>
      <a class="rail__link" href={LINKS.linkedin} target="_blank" rel="noopener noreferrer">{LINKS.linkedinLabel}</a>
    </li>
    <li>
      <a class="rail__link" href={`mailto:${LINKS.email}`}>{LINKS.email}</a>
    </li>
  </ul>

  <div class="rail__controls">
    <button type="button" class="rail__control js-only" data-theme-toggle aria-label={t.themeAria}>
      <svg
        data-icon="moon"
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.8 6.8 0 0 0 9.8 9.8Z"></path>
      </svg>
      <svg
        data-icon="sun"
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4.2"></circle>
        <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6 7 7M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"></path>
      </svg>
      <span class="theme-label theme-label--to-light">{t.themeToLight}</span>
      <span class="theme-label theme-label--to-dark">{t.themeToDark}</span>
    </button>

    <span class="rail__divider js-only" aria-hidden="true"></span>

    <div class="rail__langs" role="group" aria-label={t.langAria}>
      {
        LANGUAGES.map((language) => (
          <a
            class="rail__lang"
            href={language.href}
            hreflang={language.code}
            aria-current={lang === language.code ? 'true' : undefined}
          >
            {language.label}
          </a>
        ))
      }
    </div>
  </div>

  <div class="rail__palette js-only">
    <button
      type="button"
      class="rail__control"
      data-palette-toggle
      aria-expanded="false"
      aria-controls="palette-list"
    >
      <svg
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="3"></circle>
        <path d="M12 3v2.2M12 18.8V21M4.2 7.5l1.9 1.1M17.9 15.4l1.9 1.1M4.2 16.5l1.9-1.1M17.9 8.6l1.9-1.1"></path>
      </svg>
      {t.paletteLabel}
    </button>

    <ul class="rail__palette-list" id="palette-list" data-palette-list hidden>
      {
        PALETTES.map((palette) => (
          <li>
            <button
              type="button"
              class="rail__palette-item"
              data-palette-item
              data-dark={palette.dark}
              data-light={palette.light}
              aria-pressed="false"
            >
              <span
                class="rail__swatch"
                aria-hidden="true"
                style={`--sw-dark:${palette.dark};--sw-light:${palette.light}`}
              />
              {palette.name}
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</aside>
