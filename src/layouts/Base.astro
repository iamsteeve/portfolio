---
// Newsreader ships an optical-size axis; the prototype loaded it from Google
// Fonts as opsz 6..72, so use the opsz files here to keep metrics identical.
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

import Rail from '../components/Rail.astro';
import type { Copy } from '../content/types';
import { CANONICAL, OG_LOCALE, SITE_URL, type Lang } from '../data/site';

interface Props {
  lang: Lang;
  t: Copy;
}

const { lang, t } = Astro.props;
const alternate: Lang = lang === 'en' ? 'es' : 'en';
const ogImage = `${SITE_URL}/og-image.png`;
---

<!doctype html>
<html class="no-js" lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="author" content="Steeve Luis Angel Torres Agustin" />
    <meta name="robots" content="index, follow" />

    <link rel="canonical" href={CANONICAL[lang]} />
    <link rel="alternate" hreflang="en" href={CANONICAL.en} />
    <link rel="alternate" hreflang="es" href={CANONICAL.es} />
    <link rel="alternate" hreflang="x-default" href={CANONICAL.en} />

    <meta property="og:type" content="profile" />
    <meta property="og:url" content={CANONICAL[lang]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta property="og:title" content={t.meta.ogTitle} />
    <meta property="og:description" content={t.meta.ogDescription} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:locale:alternate" content={OG_LOCALE[alternate]} />
    <meta property="profile:first_name" content="Steeve" />
    <meta property="profile:last_name" content="Torres Agustin" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.twitterTitle} />
    <meta name="twitter:description" content={t.meta.twitterDescription} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0B1220" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <script is:inline>
      // Before first paint: enable JS-only controls and honour the OS theme.
      // The in-page toggle overrides this for the session. No storage.
      document.documentElement.classList.remove('no-js');
      if (window.matchMedia('(prefers-color-scheme: light)').matches) {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    </script>
  </head>

  <body>
    <div class="page">
      <a class="skip" href="#top">{t.skip}</a>

      <Rail lang={lang} t={t} />

      <main class="main" id="top">
        <slot />
      </main>
    </div>

    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>
